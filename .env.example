# ─── Server ───────────────────────────────────────────────────
PORT=3001

# ─── WhatsApp Cloud API credentials ──────────────────────────
# Get these from: developers.facebook.com → Your App → WhatsApp → API Setup
VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WABA_ID=your_whatsapp_business_account_id_here

# ─── ngrok (optional — for local tunnel) ─────────────────────
# Get free token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# ─── Dashboard login ──────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=admin@123
SESSION_SECRET=change_this_to_a_long_random_string
